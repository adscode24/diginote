rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function signedIn() {
      return request.auth != null;
    }
    // Anggota vault (dokumen baru).
    function isMember(vault) {
      return signedIn() && request.auth.uid in vault.members;
    }
    // Pemilik vault lama tanpa `members` (migrasi otomatis saat tulis pertama).
    function isLegacyOwner(vault, uid) {
      return signedIn() && !('members' in vault) && request.auth.uid == uid;
    }
    // Pemilik dokumen (ID dokumen == UID sendiri).
    function isDocOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Pasangan tertaut: UID ada di pairedUids dokumen.
    function isPaired(vault) {
      return signedIn() && ('pairedUids' in vault) && request.auth.uid in vault.pairedUids;
    }

    // ---------- Vault keuangan (pribadi / berdua) ----------
    // Dokumen ID == UID pemilik. Berdua = tautan via `pairedUids` di kedua sisi.
    // Tulis partner hanya untuk field data + cap + identitas (tak boleh ubah
    // pairing/kode/identitas pemilik). `resource == null` = dokumen belum ada
    // (izinkan baca agar user/vault baru tidak permission-denied).
    match /digiVaults/{uid} {
      allow get: if resource == null
        || isMember(resource.data)
        || isLegacyOwner(resource.data, uid)
        || isDocOwner(uid)
        || isPaired(resource.data);
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if isMember(resource.data)
        || isLegacyOwner(resource.data, uid)
        || isDocOwner(uid)
        || (
          signedIn()
          && request.auth.uid in resource.data.pairedUids
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['transactions', 'categories', 'accounts', 'debts', 'bills',
                      'billPayments', 'reminderSettings', 'updatedAt', 'lastUpdatedBy',
                      'lastUpdatedByCode', 'schemaVersion'])
        );
      allow delete: if isDocOwner(uid);
    }

    // ---------- Direktori vault per email (verifikasi undangan) ----------
    // ID dokumen = email kecil. Dibaca siapa pun yang login, ditulis hanya
    // pemilik UID yang tercantum (plus baca dokumen kosong).
    match /vaultDirectory/{email} {
      allow get: if resource == null || signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Undangan berdua: coupleInvites/{uidPenerima} ----------
    // Satu undangan tertunda per penerima. Dibaca pengirim/penerima (plus
    // dokumen kosong), dibuat pengirim, dihapus pengirim/penerima.
    match /coupleInvites/{toUid} {
      allow get: if resource == null
        || (signedIn() && (request.auth.uid == toUid || request.auth.uid == resource.data.fromUid));
      allow list: if false;
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == toUid || request.auth.uid == resource.data.fromUid);
    }
  }
}
