rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function signedIn() {
      return request.auth != null;
    }
    // Anggota vault (dokumen baru). Dokumen lama tanpa `members` tetap bisa
    // diakses pemiliknya (migrasi otomatis saat tulis pertama).
    function isMember(vault) {
      return signedIn() && request.auth.uid in vault.members;
    }
    function isLegacyOwner(vault, uid) {
      return signedIn() && !('members' in vault) && request.auth.uid == uid;
    }
    function isOwner(vaultUid) {
      return signedIn()
        && get(/databases/$(database)/documents/digiVaults/$(vaultUid)).data.members[0]
          == request.auth.uid;
    }

    // ---------- Vault keuangan (pribadi / berdua) ----------
    // Dokumen ID == uid pemilik pertama. Pasangan bergabung via kode undangan
    // (lihat vaultInvites) lalu UID-nya masuk `members`.
    // `resource == null`: dokumen belum ada (user baru) — izinkan baca agar
    // pembuatan vault pertama tidak ditolak permission-denied.
    match /digiVaults/{uid} {
      allow get: if resource == null || isMember(resource.data) || isLegacyOwner(resource.data, uid);
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if isMember(resource.data)
        || isLegacyOwner(resource.data, uid)
        || (
          // Gabung via kode: hanya boleh menyentuh members/memberProfiles
          // dan UID sendiri wajib ada di hasil akhir. Tidak perlu baca dulu
          // (klien memakai arrayUnion), berlaku juga untuk vault lama.
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberProfiles'])
          && request.auth.uid in request.resource.data.members
        );
      allow delete: if false;
    }

    // ---------- Undangan berdua: vaultInvites/{KODE} ----------
    // Dibaca siapa pun yang login (untuk gabung via kode), ditulis hanya pemilik vault.
    match /vaultInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isOwner(request.resource.data.vaultUid);
      allow update, delete: if isOwner(resource.data.vaultUid);
    }
  }
}
